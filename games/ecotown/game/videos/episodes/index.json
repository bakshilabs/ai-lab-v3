{
 "episodes": {
  "land-open": {
   "mission": "land",
   "kind": "open",
   "n": 1,
   "title": "The best land",
   "mp4": "land-open.mp4",
   "poster": "land-open.jpg",
   "vtt": "land-open.vtt",
   "duration": 29.28,
   "bytes": 1451313,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.9,
     "who": "Narrator",
     "text": "This is Eco Town. Florence the robot is planning it."
    },
    {
     "t0": 4.97,
     "t1": 8,
     "who": "Posy",
     "text": "Florence! Please find the best land for our town."
    },
    {
     "t0": 8.07,
     "t1": 9.71,
     "who": "Florence",
     "text": "Best land? Easy!"
    },
    {
     "t0": 9.78,
     "t1": 14.34,
     "who": "Florence",
     "text": "Here! Flat, wide and right by the river. I am 82% sure!"
    },
    {
     "t0": 16.01,
     "t1": 18.93,
     "who": "Dev",
     "text": "Hmm. Why is the grass so squelchy?"
    },
    {
     "t0": 19.8,
     "t1": 23.23,
     "who": "Narrator",
     "text": "Flat land looks best to Florence. But what did she miss?"
    },
    {
     "t0": 23.3,
     "t1": 25.61,
     "who": "Narrator",
     "text": "Step into the AI Lab and check."
    }
   ]
  },
  "land-close": {
   "mission": "land",
   "kind": "close",
   "n": 1,
   "title": "The flood",
   "mp4": "land-close.mp4",
   "poster": "land-close.jpg",
   "vtt": "land-close.vtt",
   "duration": 31.67,
   "bytes": 1458451,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.75,
     "who": "Narrator",
     "text": "Winter came to Eco Town. And so did the rain."
    },
    {
     "t0": 4.82,
     "t1": 8.66,
     "who": "Dev",
     "text": "Look through the flood lens! The meadow floods every winter."
    },
    {
     "t0": 8.73,
     "t1": 11.15,
     "who": "Florence",
     "text": "Oops. You said best. I guessed flat."
    },
    {
     "t0": 11.22,
     "t1": 14.43,
     "who": "Posy",
     "text": "Try this. Dry, sunny land. Keep the meadow wild."
    },
    {
     "t0": 14.5,
     "t1": 18.29,
     "who": "Florence",
     "text": "Dry land on the slope. The meadow stays wild. Checked!"
    },
    {
     "t0": 18.36,
     "t1": 23.48,
     "who": "Narrator",
     "text": "Flat land by a river can flood. So build on dry ground, and keep the meadow wild."
    },
    {
     "t0": 23.55,
     "t1": 28,
     "who": "Narrator",
     "text": "And an AI can take one word too far. So say what you really mean."
    }
   ]
  },
  "move-open": {
   "mission": "move",
   "kind": "open",
   "n": 2,
   "title": "Easy for everyone",
   "mp4": "move-open.mp4",
   "poster": "move-open.jpg",
   "vtt": "move-open.vtt",
   "duration": 29.37,
   "bytes": 1462463,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.9,
     "who": "Narrator",
     "text": "The town has its land. Now, how will people get around?"
    },
    {
     "t0": 4.97,
     "t1": 7.95,
     "who": "Posy",
     "text": "Make it easy for everyone to get to school!"
    },
    {
     "t0": 8.02,
     "t1": 11.79,
     "who": "Florence",
     "text": "Easy for everyone? Then everyone needs a big, wide road!"
    },
    {
     "t0": 11.86,
     "t1": 15.89,
     "who": "Florence",
     "text": "And a car park at the school gate. I am 77% sure!"
    },
    {
     "t0": 17.16,
     "t1": 19.81,
     "who": "Dev",
     "text": "But Florence, we walk to school."
    },
    {
     "t0": 20.78,
     "t1": 23.83,
     "who": "Narrator",
     "text": "Easy for everyone. Or just easy for cars?"
    },
    {
     "t0": 23.9,
     "t1": 25.7,
     "who": "Narrator",
     "text": "Who did Florence forget?"
    }
   ]
  },
  "move-close": {
   "mission": "move",
   "kind": "close",
   "n": 2,
   "title": "Look from the street",
   "mp4": "move-close.mp4",
   "poster": "move-close.jpg",
   "vtt": "move-close.vtt",
   "duration": 30.74,
   "bytes": 1469924,
   "cues": [
    {
     "t0": 1.3,
     "t1": 3.79,
     "who": "Narrator",
     "text": "It is quarter to nine. School time."
    },
    {
     "t0": 3.86,
     "t1": 7.44,
     "who": "Dev",
     "text": "Look from the street. Too many cars! We cannot cross."
    },
    {
     "t0": 7.5,
     "t1": 11.36,
     "who": "Florence",
     "text": "Oops. Nobody said how. So I guessed that everyone drives."
    },
    {
     "t0": 11.43,
     "t1": 15,
     "who": "Posy",
     "text": "Safe paths for walking and cycling. Cars stay at the edge."
    },
    {
     "t0": 15.07,
     "t1": 18.48,
     "who": "Florence",
     "text": "Paths and cycle lanes. Cars at the edge. Checked!"
    },
    {
     "t0": 18.54,
     "t1": 22.24,
     "who": "Narrator",
     "text": "A town you can walk and cycle around is safer for everyone."
    },
    {
     "t0": 22.31,
     "t1": 27.07,
     "who": "Narrator",
     "text": "And when your words leave a gap, an AI fills it with a guess. So say who you mean."
    }
   ]
  },
  "homes-open": {
   "mission": "homes",
   "kind": "open",
   "n": 3,
   "title": "Strong homes",
   "mp4": "homes-open.mp4",
   "poster": "homes-open.jpg",
   "vtt": "homes-open.vtt",
   "duration": 27.63,
   "bytes": 1452256,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.75,
     "who": "Narrator",
     "text": "Families are coming to Eco Town. They need homes."
    },
    {
     "t0": 4.82,
     "t1": 7.39,
     "who": "Posy",
     "text": "Florence, build strong homes, please!"
    },
    {
     "t0": 7.46,
     "t1": 10.33,
     "who": "Florence",
     "text": "Strong? I know strong! Concrete and steel!"
    },
    {
     "t0": 10.4,
     "t1": 13.63,
     "who": "Florence",
     "text": "They will stand for years. I am 85% sure!"
    },
    {
     "t0": 15.9,
     "t1": 19.42,
     "who": "Dev",
     "text": "They do look strong. But is strong all a home should be?"
    },
    {
     "t0": 19.49,
     "t1": 21.72,
     "who": "Narrator",
     "text": "From the sky, the homes look fine."
    },
    {
     "t0": 21.79,
     "t1": 23.96,
     "who": "Narrator",
     "text": "How can you check what you cannot see?"
    }
   ]
  },
  "homes-close": {
   "mission": "homes",
   "kind": "close",
   "n": 3,
   "title": "The hidden cloud",
   "mp4": "homes-close.mp4",
   "poster": "homes-close.jpg",
   "vtt": "homes-close.vtt",
   "duration": 31.45,
   "bytes": 1466284,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.86,
     "who": "Narrator",
     "text": "Some problems hide. Until you look through the right lens."
    },
    {
     "t0": 4.93,
     "t1": 10.1,
     "who": "Dev",
     "text": "The carbon lens! Making all that concrete gave off three times too much carbon."
    },
    {
     "t0": 10.17,
     "t1": 12.36,
     "who": "Florence",
     "text": "Oops. I only thought about strong."
    },
    {
     "t0": 12.43,
     "t1": 15.43,
     "who": "Posy",
     "text": "Warm, low-carbon homes from timber and straw."
    },
    {
     "t0": 15.5,
     "t1": 19.29,
     "who": "Florence",
     "text": "Timber and straw. Warm inside, and under the limit. Checked!"
    },
    {
     "t0": 19.36,
     "t1": 23.7,
     "who": "Narrator",
     "text": "Carbon hides in the things we build with. Timber and straw keep it low."
    },
    {
     "t0": 23.77,
     "t1": 27.78,
     "who": "Narrator",
     "text": "And a plan that looks right is not proof. Always check with evidence."
    }
   ]
  },
  "food-open": {
   "mission": "food",
   "kind": "open",
   "n": 4,
   "title": "As much as possible",
