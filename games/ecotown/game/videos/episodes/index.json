   "bytes": 1455700,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.45,
     "who": "Narrator",
     "text": "The town is growing. Now everyone needs food."
    },
    {
     "t0": 4.52,
     "t1": 7.29,
     "who": "Posy",
     "text": "Florence, grow as much food as possible!"
    },
    {
     "t0": 7.36,
     "t1": 10.44,
     "who": "Florence",
     "text": "As much as possible? Then I will plough everything!"
    },
    {
     "t0": 10.51,
     "t1": 14.43,
     "who": "Florence",
     "text": "Every field. Every hedge. I am 79% sure!"
    },
    {
     "t0": 16.1,
     "t1": 19.22,
     "who": "Dev",
     "text": "Wait. Where did the hedges go? And the bees?"
    },
    {
     "t0": 19.29,
     "t1": 21.91,
     "who": "Narrator",
     "text": "Lots of food. But who else was living here?"
    },
    {
     "t0": 21.98,
     "t1": 23.76,
     "who": "Narrator",
     "text": "What should Florence keep?"
    }
   ]
  },
  "food-close": {
   "mission": "food",
   "kind": "close",
   "n": 4,
   "title": "Enough",
   "mp4": "food-close.mp4",
   "poster": "food-close.jpg",
   "vtt": "food-close.vtt",
   "duration": 32.54,
   "bytes": 1470109,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.65,
     "who": "Narrator",
     "text": "The fields are full. But the island has gone quiet."
    },
    {
     "t0": 4.72,
     "t1": 9.54,
     "who": "Dev",
     "text": "The nature lens shows it. No hedges. So the bees and the deer have left."
    },
    {
     "t0": 9.61,
     "t1": 12.85,
     "who": "Florence",
     "text": "Oops. You said as much as possible. So I took it all."
    },
    {
     "t0": 12.92,
     "t1": 15.83,
     "who": "Posy",
     "text": "Enough food. And keep the hedges for the bees."
    },
    {
     "t0": 15.9,
     "t1": 19.73,
     "who": "Florence",
     "text": "An orchard, beehives and hedges. Enough for everyone. Checked!"
    },
    {
     "t0": 19.8,
     "t1": 24.57,
     "who": "Narrator",
     "text": "Hedges are homes and safe paths for wildlife. Enough is better than most."
    },
    {
     "t0": 24.64,
     "t1": 28.88,
     "who": "Narrator",
     "text": "And an AI does what you say, not what you mean. So tell it what to keep."
    }
   ]
  },
  "power-open": {
   "mission": "power",
   "kind": "open",
   "n": 5,
   "title": "Very, very sure",
   "mp4": "power-open.mp4",
   "poster": "power-open.jpg",
   "vtt": "power-open.vtt",
   "duration": 26.07,
   "bytes": 1458366,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.04,
     "who": "Narrator",
     "text": "Eco Town needs power. Clean power."
    },
    {
     "t0": 4.11,
     "t1": 7.22,
     "who": "Posy",
     "text": "Florence, make enough clean power for every home."
    },
    {
     "t0": 7.29,
     "t1": 11.18,
     "who": "Florence",
     "text": "Solar panels on every roof! On a normal day, that is plenty."
    },
    {
     "t0": 11.24,
     "t1": 14.48,
     "who": "Florence",
     "text": "I am 90% sure. That is very, very sure!"
    },
    {
     "t0": 14.55,
     "t1": 17.19,
     "who": "Dev",
     "text": "What about a day that is not normal?"
    },
    {
     "t0": 17.26,
     "t1": 20.62,
     "who": "Narrator",
     "text": "Ninety per cent sure. Is that the same as right?"
    },
    {
     "t0": 20.69,
     "t1": 22.4,
     "who": "Narrator",
     "text": "Which day would you test?"
    }
   ]
  },
  "power-close": {
   "mission": "power",
   "kind": "close",
   "n": 5,
   "title": "The winter night",
   "mp4": "power-close.mp4",
   "poster": "power-close.jpg",
   "vtt": "power-close.vtt",
   "duration": 33.61,
   "bytes": 1468841,
   "cues": [
    {
     "t0": 1.3,
     "t1": 4.04,
     "who": "Narrator",
     "text": "A still winter night. The sun has gone."
    },
    {
     "t0": 4.11,
     "t1": 7.47,
     "who": "Dev",
     "text": "The winter test! Look. Every light has gone out."
    },
    {
     "t0": 7.54,
     "t1": 9.95,
     "who": "Florence",
     "text": "Oops. But I was 90% sure!"
    },
    {
     "t0": 10.02,
     "t1": 13.39,
     "who": "Posy",
     "text": "Enough power for a still winter night. Store the sunshine."
    },
    {
     "t0": 13.46,
     "t1": 19.96,
     "who": "Florence",
     "text": "A wind turbine and batteries. I have not planned for winter before. Only 74% sure."
    },
    {
     "t0": 20.03,
     "t1": 22.75,
     "who": "Dev",
     "text": "Test it again. The lights stay on!"
    },
    {
     "t0": 22.82,
     "t1": 26.49,
     "who": "Narrator",
     "text": "Plan your power for the hardest night, and store some for later."
    },
    {
     "t0": 26.56,
     "t1": 29.93,
     "who": "Narrator",
     "text": "And sure is not the same as right. So test the plan."
    }
   ]
  },
  "heart-open": {
   "mission": "heart",
   "kind": "open",
